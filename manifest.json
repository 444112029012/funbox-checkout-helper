{
  "manifest_version": 3,
  "name": "Funbox 結帳助手",
  "version": "0.6.7",
  "description": "Funbox 官網：加車、打開 /carts 結帳頁、選 7-11 貨到付款。官網通常帶入個資；直接結帳僅限超商貨到付款。",
  "action": {
    "default_title": "Funbox 結帳助手",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "tabs", "scripting", "notifications"],
  "host_permissions": ["https://shop.funbox.com.tw/*"],
  "content_scripts": [
    {
      "matches": ["https://shop.funbox.com.tw/*"],
      "js": [
        "src/lib/dom.js",
        "src/lib/overlay.js",
        "src/lib/product.js",
        "src/lib/cart.js",
        "src/lib/log.js",
        "src/lib/alerts.js",
        "src/lib/fill.js",
        "src/lib/guard.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
